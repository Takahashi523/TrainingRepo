APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 本番では trustHosts の許可ホストの導出元になる（bootstrap/app.php）。
# ⚠️ スキーム（https://）を含む完全な URL で書くこと。省くと parse_url() がホストを
#    取り出せず、本番では全リクエストが 400 になる。
APP_URL=http://localhost
# trustHosts が許可するホストの「追加分」（カンマ区切り・任意）。既定は APP_URL のホストのみ。
# ホスト名の移行中に新旧2ホストを同時に通す場合や、監視が APP_URL 以外の名前で /up を
# 叩く場合にだけ設定し、移行後は空に戻すこと（許可範囲を広げたままにしない）。
# ⚠️ 書けるのは「ホスト名のみ」。ワイルドカード（*.example.com）・ポート付き
#    （example.com:8443）・スキーム付き（https://example.com）は書いても一致せず、
#    エラーにもならないまま 400 が返り続ける。ホストごとに1件ずつ列挙すること。
# 例：TRUSTED_HOSTS=new.example.com,10.0.1.20
TRUSTED_HOSTS=
# 国内 SES 向け社内ツールのため既定は JST。DB セッション TZ は DB_TIMEZONE(+09:00) と揃える。
APP_TIMEZONE=Asia/Tokyo

# 表示言語は config/app.php で 'ja' に固定しており、環境変数では切り替えられない。
# APP_LOCALE / APP_FALLBACK_LOCALE を書いても効かないため、誤読を避ける目的で項目自体を置かない。
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB セッション TZ（NOW()/CURRENT_TIMESTAMP を JST に）。名前指定は tz テーブル要のため数値オフセット。
# DB_TIMEZONE=+09:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 未設定のままにしておくこと。未設定なら HTTPS 接続時に Secure 属性が自動で付く
# （Symfony Response::prepare() が isSecure() を見て setSecureDefault(true) するため）。
# 明示的に false を書くとこの自動判定を打ち消し、HTTPS でも Secure が付かなくなる。
# HTTPS 固定の環境で明示したい場合のみ true を設定する。
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# マッチングエンジン（Python / FastAPI）連携先。ローカル代替エンジン利用時はその URL を指定する。
MATCHING_ENGINE_URL=http://python:8001
MATCHING_ENGINE_TIMEOUT=10
MATCHING_ENGINE_CONNECT_TIMEOUT=5

# 人材プロフィール要約 API（PR #12）。未設定時は MATCHING_ENGINE_URL にフォールバックする
# （config/services.php）。接続先を分ける場合のみ AI_SUMMARY_URL を上書きすること。
# AI_SUMMARY_URL=http://python:8001
AI_SUMMARY_TIMEOUT=30
AI_SUMMARY_CONNECT_TIMEOUT=5
# CSVインポート経由の一括AI要約生成（issue #61）の経過時間予算（秒）。この秒数を超えた分は
# 生成をスキップし、対象の人材詳細画面から個別に再生成する運用とする。
AI_SUMMARY_CSV_TRIGGER_BUDGET_SECONDS=20

VITE_APP_NAME="${APP_NAME}"

# マスタ管理：ユーザーのメールアドレスに許可するドメイン（カンマ区切り・複数可）。
# 空の場合はドメイン制限なし（形式チェックのみ）。例：ALLOWED_EMAIL_DOMAINS=nexus.example.com,nexus.co.jp
ALLOWED_EMAIL_DOMAINS=
