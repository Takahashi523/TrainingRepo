APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# 国内 SES 向け社内ツールのため既定は JST。DB セッション TZ は DB_TIMEZONE(+09:00) と揃える。
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB セッション TZ（NOW()/CURRENT_TIMESTAMP を JST に）。名前指定は tz テーブル要のため数値オフセット。
# DB_TIMEZONE=+09:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# マッチングエンジン（Python / FastAPI）連携先。ローカル代替エンジン利用時はその URL を指定する。
MATCHING_ENGINE_URL=http://python:8001
MATCHING_ENGINE_TIMEOUT=10
MATCHING_ENGINE_CONNECT_TIMEOUT=5

VITE_APP_NAME="${APP_NAME}"

# マスタ管理：ユーザーのメールアドレスに許可するドメイン（カンマ区切り・複数可）。
# 空の場合はドメイン制限なし（形式チェックのみ）。例：ALLOWED_EMAIL_DOMAINS=nexus.example.com,nexus.co.jp
ALLOWED_EMAIL_DOMAINS=
