FROM python:3.12-slim

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 8001

# コンテナ起動時に requirements.txt を自動インストールして uvicorn を起動
# ライブラリ追加時は requirements.txt に追記して docker-compose restart python を実行
CMD ["sh", "-c", "pip install -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload"]
