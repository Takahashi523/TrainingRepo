# docker-compose.prod.yml が変数展開に使う値の雛形。
#
# 使い方:
#   cp .env.prod.example .env
#   # 値を設定してから
#   docker compose -f docker-compose.prod.yml -p trainingrepo-prod up -d
#
# ⚠️ このファイルをコピーした .env は .gitignore 済み。コミットしないこと。

# MySQL の root パスワード。
# 生成例: openssl rand -base64 32
# 既定値は用意しない（未設定なら compose が起動時にエラーで止まる）。
MYSQL_ROOT_PASSWORD=

# laravel の healthcheck 用の Host 設定はここでは行わない。
# 以前は APP_HOST（この compose 用 .env）で明示していたが、
# laravel/.env の TRUSTED_HOSTS=127.0.0.1 に一本化した
# （ホスト名変更のたびに更新箇所が増えるのを避けるため）。
# 詳細は laravel/.env.example と docs/インフラ構成図.md を参照。
