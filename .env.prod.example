# docker-compose.prod.yml が変数展開に使う値の雛形。
#
# 使い方:
#   cp .env.prod.example .env
#   # 値を設定してから
#   docker compose -f docker-compose.prod.yml -p trainingrepo-prod up -d
#
# ⚠️ このファイルをコピーした .env は .gitignore 済み。コミットしないこと。

# MySQL の root パスワード。
# 生成例: openssl rand -base64 32
# 既定値は用意しない（未設定なら compose が起動時にエラーで止まる）。
MYSQL_ROOT_PASSWORD=

# laravel の healthcheck が送る Host ヘッダー。
# laravel/.env の APP_URL のホスト部分と完全に一致させること。
#   例) APP_URL=https://54-168-196-65.nip.io → APP_HOST=54-168-196-65.nip.io
#
# 一致していないと Laravel の trustHosts が 400 を返し、healthcheck が永久に失敗する。
# その結果 nginx の depends_on: condition: service_healthy が満たされず、
# 前段 nginx が起動しない＝HTTPS が全面停止する。
# ホスト名を変更したときは APP_URL とあわせてここも更新すること。
APP_HOST=
